{
  "name": "@midnight-ntwrk/trust-registry-integration",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-trust-registry.git",
    "directory": "packages/trust-registry-integration"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "integration": "node scripts/check-vc-composition.mjs && vitest run --dir src/test",
    "test:light": "node scripts/check-vc-composition.mjs",
    "build:light": "pnpm run build"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/credential-compact": "0.2.0",
    "@midnight-ntwrk/credential-did-midnight": "0.2.0",
    "@midnight-ntwrk/midnight-did": "0.7.0",
    "@midnight-ntwrk/midnight-did-contract": "0.7.0",
    "@midnight-ntwrk/midnight-did-domain": "0.7.0",
    "@midnight-ntwrk/trust-registry-client": "workspace:0.1.0",
    "@midnight-ntwrk/trust-registry-contract": "workspace:0.1.0",
    "@midnight-ntwrk/trust-registry-domain": "workspace:0.1.0"
  }
}
