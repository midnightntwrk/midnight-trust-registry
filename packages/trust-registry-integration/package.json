{
  "name": "@midnight-ntwrk/trust-registry-integration",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-trust-registry.git",
    "directory": "packages/trust-registry-integration"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local-pinned-submission-provider": {
      "types": "./dist/local-pinned-submission-provider.d.ts",
      "import": "./dist/local-pinned-submission-provider.js"
    },
    "./fixtures/vc-authority-consumer.compact": "./src/compact/vc-authority-consumer.compact"
  },
  "files": [
    "dist/**",
    "src/compact/vc-authority-consumer.compact",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "integration": "node scripts/check-vc-composition.mjs && vitest run --dir src/test --testTimeout 15000",
    "integration:light": "pnpm run integration",
    "test:light": "node scripts/check-vc-composition.mjs",
    "build:light": "pnpm run build"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/credential-compact": "0.2.0",
    "@midnight-ntwrk/credential-did-midnight": "0.2.0",
    "@midnight-ntwrk/midnight-did": "0.7.0",
    "@midnight-ntwrk/midnight-did-contract": "0.7.0",
    "@midnight-ntwrk/midnight-did-domain": "0.7.0",
    "@midnight-ntwrk/midnight-did-jubjub-schnorr": "0.7.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-node-client": "1.1.2",
    "@midnight-ntwrk/trust-registry-client": "workspace:0.1.0",
    "@midnight-ntwrk/trust-registry-contract": "workspace:0.1.0",
    "@midnight-ntwrk/trust-registry-domain": "workspace:0.1.0",
    "effect": "3.22.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  }
}
