{
  "name": "@midnight-ntwrk/trust-registry-api",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-trust-registry.git",
    "directory": "packages/trust-registry-api"
  },
  "bin": {
    "trust-registry-api": "./bin/trust-registry-api.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "bin/trust-registry-api.mjs",
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "build:light": "pnpm run build",
    "test:light": "vitest run --testTimeout 30000"
  },
  "dependencies": {
    "@midnight-ntwrk/trust-registry-cli": "workspace:0.1.0",
    "@midnight-ntwrk/trust-registry-domain": "workspace:0.1.0",
    "@midnight-ntwrk/trust-registry-trqp-adapter": "workspace:0.1.0",
    "zod": "^4.1.0"
  }
}
