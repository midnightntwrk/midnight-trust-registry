{
  "name": "@midnight-ntwrk/trust-registry-applicant-portal",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-trust-registry.git",
    "directory": "packages/trust-registry-applicant-portal"
  },
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-static.mjs && node ./scripts/bundle-browser.mjs",
    "test": "vitest run",
    "integration": "pnpm run test",
    "integration:light": "pnpm run test",
    "serve": "pnpm run build && node ./scripts/serve.mjs",
    "build:light": "pnpm run build",
    "test:light": "pnpm run test"
  },
  "dependencies": {
    "@midnight-ntwrk/trust-registry-api": "workspace:0.1.0",
    "@midnight-ntwrk/trust-registry-domain": "workspace:0.1.0"
  },
  "devDependencies": {
    "happy-dom": "20.14.5"
  }
}
