{
  "name": "@midnight-ntwrk/trust-registry-applicant-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-static.mjs",
    "test": "vitest run",
    "serve": "pnpm run build && node ./scripts/serve.mjs",
    "build:light": "pnpm run build",
    "test:light": "pnpm run test"
  },
  "dependencies": {
    "@midnight-ntwrk/trust-registry-api": "workspace:0.1.0"
  }
}
