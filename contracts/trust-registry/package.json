{
  "name": "@midnight-ntwrk/trust-registry-contract",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "require": "./dist/contract.js",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "require": "./dist/signing.js",
      "import": "./dist/signing.js",
      "default": "./dist/signing.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "require": "./dist/testing.js",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./managed/trust-registry/contract/index.js": {
      "types": "./dist/managed/trust-registry/contract/index.d.ts",
      "import": "./dist/managed/trust-registry/contract/index.js",
      "default": "./dist/managed/trust-registry/contract/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "dist/contract.d.ts"
      ],
      "signing": [
        "dist/signing.d.ts"
      ],
      "testing": [
        "dist/testing.d.ts"
      ],
      "managed/trust-registry/contract/index.js": [
        "dist/managed/trust-registry/contract/index.d.ts"
      ]
    }
  },
  "scripts": {
    "contract": "npm run compact",
    "compact": "compact compile src/trust-registry.compact src/managed/trust-registry && node ./scripts/align-runtime-version.mjs && node ./scripts/strip-managed-sourcemaps.mjs",
    "test": "vitest run",
    "pretest:ci": "npm run compact",
    "test:ci": "vitest run",
    "prepack": "npm run build",
    "clean": "rm -rf dist && rm -rf coverage && rm -rf reports && rm -rf src/managed && rm -f tsconfig.build.tsbuildinfo",
    "build": "npm run compact && rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist && cp -Rf ./src/managed ./dist/ && cp ./src/trust-registry.compact ./dist",
    "lint": "eslint src --ext .ts --ignore-pattern 'src/managed/**'",
    "lint:fix": "eslint src --ext .ts --fix --ignore-pattern 'src/managed/**'",
    "typecheck": "npm run compact && tsc -p tsconfig.json --noEmit",
    "all": "npm run compact && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.15.0",
    "@midnight-ntwrk/midnight-did-jubjub-schnorr": "file:../../libs/midnight-did/jubjub-schnorr"
  },
  "files": [
    "dist/**",
    "src/**/*.compact",
    "README.md",
    "scripts/*.mjs",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ]
}
