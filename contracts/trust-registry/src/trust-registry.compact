  epochIdValue: Bytes<32>,
  stateRootValue: Bytes<32>,
  eventRootValue: Bytes<32>,
  policyRootValue: Bytes<32>,
  validFromSequenceValue: Uint<64>,
  validUntilSequenceValue: Uint<64>
): [] {
  assert(epochIdValue != pad(32, ""), "Epoch id must be set");
  assert(stateRootValue != pad(32, ""), "Epoch state root must be set");
  assert(eventRootValue != pad(32, ""), "Epoch event root must be set");
  assert(policyRootValue != pad(32, ""), "Epoch policy root must be set");
  assert(
    validUntilSequenceValue > validFromSequenceValue,
    "Epoch valid until must be later than valid from"
  );
}

pure circuit registryInitializationPayloadHash(
  registryDidCommitmentValue: Bytes<32>,
  governancePolicyCommitmentValue: Bytes<32>,
  bootstrapMaintainerKeyId: Bytes<32>,
  bootstrapMaintainerPublicKey: JubjubPoint
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    registryDidCommitmentValue,
    governancePolicyCommitmentValue,
    bootstrapMaintainerKeyId,
    maintainerPublicKeyCommitment(bootstrapMaintainerPublicKey)
  ]);
}

export pure circuit issuerAuthorizationScopeKey(
  subjectDidCommitment: Bytes<32>,
  resourceType: IssuerResourceType,
  resourceId: Bytes<32>
): Bytes<32> {
