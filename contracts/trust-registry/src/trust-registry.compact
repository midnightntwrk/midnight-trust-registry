pragma language_version >= 0.20;

import CompactStandardLibrary;
import "../../../libs/midnight-did/jubjub-schnorr/src/schnorr" prefix Schnorr_;

export enum MaintainerStatus {
  active,
  suspended,
  revoked,
  archived
}

export struct MaintainerRecord {
  keyId: Bytes<32>,
  publicKey: JubjubPoint,
  status: MaintainerStatus,
  joinedAtSequence: Uint<64>,
  lastStatusSequence: Uint<64>,
}

export enum AuthorizationStatus {
  active,
  suspended,
  revoked,
  archived
}

export enum IssuerResourceType {
  credentialFamily,
  schema,
  schemaVersion,
  credentialDefinition,
  statusMethodRequirement
}

export struct IssuerAuthorizationRecord {
  authorizationId: Bytes<32>,
  subjectDidCommitment: Bytes<32>,
  resourceType: IssuerResourceType,
  resourceId: Bytes<32>,
  policyId: Bytes<32>,
  trustLevel: Bytes<32>,
  status: AuthorizationStatus,
  proposedAtSequence: Uint<64>,
  authorizedAtSequence: Uint<64>,
  activeFromSequence: Uint<64>,
  suspendedAtSequence: Uint<64>,
  revokedAtSequence: Uint<64>,
  archivedAtSequence: Uint<64>,
  lastStatusSequence: Uint<64>,
  evidenceHash: Bytes<32>,
  lifecycleEventHash: Bytes<32>,
}

export struct JubjubSignature {
  announcement: JubjubPoint,
  response: Field,
}

struct AuthorizedMaintainerAction {
  actionSequence: Uint<64>,
  eventHash: Bytes<32>,
  maintainerKeyId: Bytes<32>,
  actionKind: Bytes<32>,
  actionPayloadHash: Bytes<32>,
}

export ledger contractVersion: Uint<32>;
export ledger initialized: Boolean;
export ledger registryId: Bytes<32>;
export ledger registryDidCommitment: Bytes<32>;
export ledger governancePolicyCommitment: Bytes<32>;
export ledger maintainerThreshold: Uint<64>;
export ledger activeMaintainerCount: Counter;
export ledger governanceActionCount: Counter;
export ledger maintainerKeyIds: Set<Bytes<32>>;
export ledger maintainerRecords: Map<Bytes<32>, MaintainerRecord>;
export ledger governanceEventHashes: Set<Bytes<32>>;
export ledger lastGovernanceEventHash: Bytes<32>;
export ledger lastAuthorizedActionKind: Bytes<32>;
export ledger lastAuthorizedActionPayloadHash: Bytes<32>;
export ledger lastAuthorizedMaintainerKeyId: Bytes<32>;
export ledger issuerAuthorizationCount: Counter;
export ledger activeIssuerAuthorizationCount: Uint<64>;
export ledger issuerAuthorizationIds: Set<Bytes<32>>;
export ledger issuerAuthorizationRecords: Map<Bytes<32>, IssuerAuthorizationRecord>;
export ledger currentIssuerAuthorizationIdsByScopeKey: Map<Bytes<32>, Bytes<32>>;

constructor() {
  contractVersion = 1;
  initialized = false;
  registryId = pad(32, "midnight:tr:unset");
  registryDidCommitment = pad(32, "midnight:tr:unset");
  governancePolicyCommitment = pad(32, "midnight:tr:unset");
  maintainerThreshold = 0;
  activeIssuerAuthorizationCount = 0;
  lastGovernanceEventHash = pad(32, "midnight:tr:none");
  lastAuthorizedActionKind = pad(32, "midnight:tr:none");
  lastAuthorizedActionPayloadHash = pad(32, "midnight:tr:none");
  lastAuthorizedMaintainerKeyId = pad(32, "midnight:tr:none");
}

export pure circuit assertValidMaintainerThreshold(
  activeCount: Uint<64>,
  threshold: Uint<64>
): [] {
  assert(activeCount > 0, "Maintainer count must be at least 1");
  assert(threshold > 0, "Maintainer threshold must be at least 1");
  assert(
    threshold <= activeCount,
    "Maintainer threshold may not exceed active maintainer count"
  );
}

export pure circuit assertSingleSignatureMaintainerThreshold(
  activeCount: Uint<64>,
  threshold: Uint<64>
): [] {
  assertValidMaintainerThreshold(activeCount, threshold);
  assert(
    threshold == 1,
    "Single-signature maintainer authorization requires threshold 1"
  );
}

export pure circuit maintainerActionDigest(
  registryIdValue: Bytes<32>,
  actionKind: Bytes<32>,
  actionPayloadHash: Bytes<32>,
  actionSequence: Uint<64>
): Vector<4, Field> {
  assert(registryIdValue != pad(32, ""), "Registry id must be set");
  assert(actionKind != pad(32, ""), "Action kind must be set");
  assert(actionPayloadHash != pad(32, ""), "Action payload hash must be set");
  return [
    transientHash<Bytes<32>>(registryIdValue),
    transientHash<Bytes<32>>(actionKind),
    transientHash<Bytes<32>>(actionPayloadHash),
    actionSequence as Field
  ];
}

export pure circuit schnorrChallengeDigest(
  ann_x: Field,
  ann_y: Field,
  pk_x: Field,
  pk_y: Field,
  digest: Vector<4, Field>
): Field {
  return Schnorr_schnorrChallengeDigest(ann_x, ann_y, pk_x, pk_y, digest);
}

pure circuit maintainerPublicKeyCommitment(publicKey: JubjubPoint): Bytes<32> {
  return upgradeFromTransient(transientHash<JubjubPoint>(publicKey));
}

pure circuit issuerResourceTypeLabel(
  resourceType: IssuerResourceType
): Bytes<32> {
  if (resourceType == IssuerResourceType.credentialFamily) {
    return pad(32, "credential-family");
  } else if (resourceType == IssuerResourceType.schema) {
    return pad(32, "schema");
  } else if (resourceType == IssuerResourceType.schemaVersion) {
    return pad(32, "schema-version");
  } else if (resourceType == IssuerResourceType.credentialDefinition) {
    return pad(32, "credential-definition");
  } else {
    return pad(32, "status-method-requirement");
  }
}

pure circuit assertIssuerAuthorizationFields(
  authorizationIdValue: Bytes<32>,
  subjectDidCommitmentValue: Bytes<32>,
  resourceIdValue: Bytes<32>,
  policyIdValue: Bytes<32>,
  trustLevelValue: Bytes<32>,
  evidenceHashValue: Bytes<32>
): [] {
  assert(
    authorizationIdValue != pad(32, ""),
    "Issuer authorization id must be set"
  );
  assert(
    subjectDidCommitmentValue != pad(32, ""),
    "Issuer subject DID commitment must be set"
  );
  assert(
    resourceIdValue != pad(32, ""),
    "Issuer authorization resource id must be set"
  );
  assert(
    policyIdValue != pad(32, ""),
    "Issuer authorization policy id must be set"
  );
  assert(
    trustLevelValue != pad(32, ""),
    "Issuer authorization trust level must be set"
  );
  assert(
    evidenceHashValue != pad(32, ""),
    "Issuer authorization evidence hash must be set"
  );
}

pure circuit registryInitializationPayloadHash(
  registryDidCommitmentValue: Bytes<32>,
  governancePolicyCommitmentValue: Bytes<32>,
  bootstrapMaintainerKeyId: Bytes<32>,
  bootstrapMaintainerPublicKey: JubjubPoint
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    registryDidCommitmentValue,
    governancePolicyCommitmentValue,
    bootstrapMaintainerKeyId,
    maintainerPublicKeyCommitment(bootstrapMaintainerPublicKey)
  ]);
}

export pure circuit issuerAuthorizationScopeKey(
  subjectDidCommitment: Bytes<32>,
  resourceType: IssuerResourceType,
  resourceId: Bytes<32>
): Bytes<32> {
  assert(
    subjectDidCommitment != pad(32, ""),
    "Issuer subject DID commitment must be set"
  );
  assert(
    resourceId != pad(32, ""),
    "Issuer authorization resource id must be set"
  );
  return persistentHash<Vector<3, Bytes<32>>>([
    subjectDidCommitment,
    issuerResourceTypeLabel(resourceType),
    resourceId
  ]);
}

export pure circuit createIssuerAuthorizationPayloadHash(
  authorizationId: Bytes<32>,
  subjectDidCommitment: Bytes<32>,
  resourceType: IssuerResourceType,
  resourceId: Bytes<32>,
  policyId: Bytes<32>,
  trustLevel: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  assertIssuerAuthorizationFields(
    authorizationId,
    subjectDidCommitment,
    resourceId,
    policyId,
    trustLevel,
    evidenceHash
  );
  return persistentHash<Vector<7, Bytes<32>>>([
    authorizationId,
    subjectDidCommitment,
    issuerResourceTypeLabel(resourceType),
    resourceId,
    policyId,
    trustLevel,
    evidenceHash
  ]);
}

export pure circuit updateIssuerAuthorizationPayloadHash(
  authorizationId: Bytes<32>,
  previousLifecycleEventHash: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  assert(
    authorizationId != pad(32, ""),
    "Issuer authorization id must be set"
  );
  assert(
    previousLifecycleEventHash != pad(32, ""),
    "Issuer authorization lifecycle event hash must be set"
  );
  assert(
    evidenceHash != pad(32, ""),
    "Issuer authorization evidence hash must be set"
  );
  return persistentHash<Vector<3, Bytes<32>>>([
    authorizationId,
    previousLifecycleEventHash,
    evidenceHash
  ]);
}

export pure circuit governanceEventHash(
  registryIdValue: Bytes<32>,
  maintainerKeyId: Bytes<32>,
  actionKind: Bytes<32>,
  actionPayloadHash: Bytes<32>,
  actionSequence: Uint<64>
): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    registryIdValue,
    maintainerKeyId,
    actionKind,
    actionPayloadHash,
    ((actionSequence as Field) as Bytes<32>)
  ]);
}

export circuit initializeRegistry(
  nextRegistryId: Bytes<32>,
  nextRegistryDidCommitment: Bytes<32>,
  nextGovernancePolicyCommitment: Bytes<32>,
  bootstrapMaintainerKeyId: Bytes<32>,
  bootstrapMaintainerPublicKey: JubjubPoint,
  nextMaintainerThreshold: Uint<64>
): [] {
  assert(!initialized, "Trust registry has already been initialized");
  assert(nextRegistryId != pad(32, ""), "Registry id must be set");
  assert(
    nextRegistryId != pad(32, "midnight:tr:unset"),
    "Registry id must not reuse the unset sentinel"
  );
  assert(
    nextRegistryDidCommitment != pad(32, ""),
    "Registry DID commitment must be set"
  );
  assert(
    nextGovernancePolicyCommitment != pad(32, ""),
    "Governance policy commitment must be set"
  );
  assert(
    bootstrapMaintainerKeyId != pad(32, ""),
    "Bootstrap maintainer key id must be set"
  );
  assertValidMaintainerThreshold(1, nextMaintainerThreshold);

  const disclosedRegistryId = disclose(nextRegistryId);
  const disclosedRegistryDidCommitment = disclose(nextRegistryDidCommitment);
  const disclosedGovernancePolicyCommitment = disclose(
    nextGovernancePolicyCommitment
  );
  const disclosedMaintainerKeyId = disclose(bootstrapMaintainerKeyId);
  const disclosedMaintainerPublicKey = disclose(bootstrapMaintainerPublicKey);
  const initializationPayloadHash = disclose(
    registryInitializationPayloadHash(
      disclosedRegistryDidCommitment,
      disclosedGovernancePolicyCommitment,
      disclosedMaintainerKeyId,
      disclosedMaintainerPublicKey
    )
  );
  const initializationEventHash = disclose(
    governanceEventHash(
      disclosedRegistryId,
      disclosedMaintainerKeyId,
      pad(32, "midnight:tr:init"),
      initializationPayloadHash,
      0
    )
  );

  registryId = disclosedRegistryId;
  registryDidCommitment = disclosedRegistryDidCommitment;
  governancePolicyCommitment = disclosedGovernancePolicyCommitment;
  maintainerThreshold = disclose(nextMaintainerThreshold);
  maintainerKeyIds.insert(disclosedMaintainerKeyId);
  maintainerRecords.insert(
    disclosedMaintainerKeyId,
    MaintainerRecord {
      keyId: disclosedMaintainerKeyId,
      publicKey: disclosedMaintainerPublicKey,
      status: MaintainerStatus.active,
      joinedAtSequence: 0,
      lastStatusSequence: 0
    }
  );
  governanceEventHashes.insert(initializationEventHash);
  activeMaintainerCount.increment(1);
  governanceActionCount.increment(1);
  lastGovernanceEventHash = initializationEventHash;
  lastAuthorizedActionKind = pad(32, "midnight:tr:init");
  lastAuthorizedActionPayloadHash = initializationPayloadHash;
  lastAuthorizedMaintainerKeyId = disclosedMaintainerKeyId;
  initialized = true;
}

circuit performAuthorizedMaintainerAction(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  actionKind: Bytes<32>,
  actionPayloadHash: Bytes<32>
): AuthorizedMaintainerAction {
  assert(initialized, "Trust registry is not initialized");
  assert(
    maintainerKeyId != pad(32, ""),
    "Maintainer key id must be set"
  );

  const disclosedMaintainerKeyId = disclose(maintainerKeyId);
  const disclosedMaintainerPublicKey = disclose(maintainerPublicKey);
  const disclosedActionKind = disclose(actionKind);
  const disclosedActionPayloadHash = disclose(actionPayloadHash);
  const actionSequence = governanceActionCount.read();
  const digest = maintainerActionDigest(
    registryId,
    disclosedActionKind,
    disclosedActionPayloadHash,
    actionSequence
  );
  const eventHash = disclose(
    governanceEventHash(
      registryId,
      disclosedMaintainerKeyId,
      disclosedActionKind,
      disclosedActionPayloadHash,
      actionSequence
    )
  );

  assert(
    maintainerKeyIds.member(disclosedMaintainerKeyId),
    "Maintainer key id is not registered"
  );
  const record = maintainerRecords.lookup(disclosedMaintainerKeyId);
  assert(
    record.status == MaintainerStatus.active,
    "Maintainer must be active"
  );
  assertSingleSignatureMaintainerThreshold(
    activeMaintainerCount.read(),
    maintainerThreshold
  );
  assert(
    jubjubPointX(record.publicKey) == jubjubPointX(disclosedMaintainerPublicKey)
      && jubjubPointY(record.publicKey)
        == jubjubPointY(disclosedMaintainerPublicKey),
    "Maintainer public key does not match the registered key"
  );

  Schnorr_schnorrVerifyDigest(
    digest,
    Schnorr_SchnorrSignature {
      announcement: signature.announcement,
      response: signature.response
    },
    disclosedMaintainerPublicKey
  );

  governanceEventHashes.insert(eventHash);
  governanceActionCount.increment(1);
  lastGovernanceEventHash = eventHash;
  lastAuthorizedActionKind = disclosedActionKind;
  lastAuthorizedActionPayloadHash = disclosedActionPayloadHash;
  lastAuthorizedMaintainerKeyId = disclosedMaintainerKeyId;
  return AuthorizedMaintainerAction {
    actionSequence: actionSequence,
    eventHash: eventHash,
    maintainerKeyId: disclosedMaintainerKeyId,
    actionKind: disclosedActionKind,
    actionPayloadHash: disclosedActionPayloadHash
  };
}

circuit requireIssuerAuthorizationRecord(
  authorizationId: Bytes<32>
): IssuerAuthorizationRecord {
  assert(
    authorizationId != pad(32, ""),
    "Issuer authorization id must be set"
  );
  assert(
    issuerAuthorizationIds.member(authorizationId),
    "Issuer authorization is not registered"
  );
  return issuerAuthorizationRecords.lookup(authorizationId);
}

circuit currentIssuerAuthorizationRecord(
  subjectDidCommitment: Bytes<32>,
  resourceType: IssuerResourceType,
  resourceId: Bytes<32>
): IssuerAuthorizationRecord {
  const scopeKey = disclose(
    issuerAuthorizationScopeKey(
      disclose(subjectDidCommitment),
      disclose(resourceType),
      disclose(resourceId)
    )
  );
  assert(
    currentIssuerAuthorizationIdsByScopeKey.member(scopeKey),
    "Issuer authorization scope is not registered"
  );
  return issuerAuthorizationRecords.lookup(
    currentIssuerAuthorizationIdsByScopeKey.lookup(scopeKey)
  );
}

export circuit authorizeMaintainerAction(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  actionKind: Bytes<32>,
  actionPayloadHash: Bytes<32>
): Bytes<32> {
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    actionKind,
    actionPayloadHash
  );
  return authorizedAction.eventHash;
}

export circuit createIssuerAuthorization(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  authorizationId: Bytes<32>,
  subjectDidCommitment: Bytes<32>,
  resourceType: IssuerResourceType,
  resourceId: Bytes<32>,
  policyId: Bytes<32>,
  trustLevel: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedAuthorizationId = disclose(authorizationId);
  const disclosedSubjectDidCommitment = disclose(subjectDidCommitment);
  const disclosedResourceType = disclose(resourceType);
  const disclosedResourceId = disclose(resourceId);
  const disclosedPolicyId = disclose(policyId);
  const disclosedTrustLevel = disclose(trustLevel);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const scopeKey = disclose(
    issuerAuthorizationScopeKey(
      disclosedSubjectDidCommitment,
      disclosedResourceType,
      disclosedResourceId
    )
  );
  const actionPayloadHash = disclose(
    createIssuerAuthorizationPayloadHash(
      disclosedAuthorizationId,
      disclosedSubjectDidCommitment,
      disclosedResourceType,
      disclosedResourceId,
      disclosedPolicyId,
      disclosedTrustLevel,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:issuer:create"),
    actionPayloadHash
  );

  assert(
    !issuerAuthorizationIds.member(disclosedAuthorizationId),
    "Issuer authorization already exists"
  );
  if (currentIssuerAuthorizationIdsByScopeKey.member(scopeKey)) {
    const currentRecord = issuerAuthorizationRecords.lookup(
      currentIssuerAuthorizationIdsByScopeKey.lookup(scopeKey)
    );
    assert(
      currentRecord.status == AuthorizationStatus.revoked
        || currentRecord.status == AuthorizationStatus.archived,
      "Issuer authorization scope already has a live authorization"
    );
  }

  issuerAuthorizationIds.insert(disclosedAuthorizationId);
  issuerAuthorizationRecords.insert(
    disclosedAuthorizationId,
    IssuerAuthorizationRecord {
      authorizationId: disclosedAuthorizationId,
      subjectDidCommitment: disclosedSubjectDidCommitment,
      resourceType: disclosedResourceType,
      resourceId: disclosedResourceId,
      policyId: disclosedPolicyId,
      trustLevel: disclosedTrustLevel,
      status: AuthorizationStatus.active,
      proposedAtSequence: authorizedAction.actionSequence,
      authorizedAtSequence: authorizedAction.actionSequence,
      activeFromSequence: authorizedAction.actionSequence,
      suspendedAtSequence: 0,
      revokedAtSequence: 0,
      archivedAtSequence: 0,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  currentIssuerAuthorizationIdsByScopeKey.insert(scopeKey, disclosedAuthorizationId);
  issuerAuthorizationCount.increment(1);
  activeIssuerAuthorizationCount = disclose(
    (activeIssuerAuthorizationCount + (1 as Uint<64>)) as Uint<64>
  );
  return authorizedAction.eventHash;
}

export circuit suspendIssuerAuthorization(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  authorizationId: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedAuthorizationId = disclose(authorizationId);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const currentRecord = requireIssuerAuthorizationRecord(disclosedAuthorizationId);
  assert(
    currentRecord.status == AuthorizationStatus.active,
    "Issuer authorization must be active to suspend"
  );
  const actionPayloadHash = disclose(
    updateIssuerAuthorizationPayloadHash(
      disclosedAuthorizationId,
      currentRecord.lifecycleEventHash,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:issuer:suspend"),
    actionPayloadHash
  );

  issuerAuthorizationRecords.insert(
    disclosedAuthorizationId,
    IssuerAuthorizationRecord {
      authorizationId: currentRecord.authorizationId,
      subjectDidCommitment: currentRecord.subjectDidCommitment,
      resourceType: currentRecord.resourceType,
      resourceId: currentRecord.resourceId,
      policyId: currentRecord.policyId,
      trustLevel: currentRecord.trustLevel,
      status: AuthorizationStatus.suspended,
      proposedAtSequence: currentRecord.proposedAtSequence,
      authorizedAtSequence: currentRecord.authorizedAtSequence,
      activeFromSequence: currentRecord.activeFromSequence,
      suspendedAtSequence: authorizedAction.actionSequence,
      revokedAtSequence: currentRecord.revokedAtSequence,
      archivedAtSequence: currentRecord.archivedAtSequence,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  activeIssuerAuthorizationCount = disclose(
    (activeIssuerAuthorizationCount - (1 as Uint<64>)) as Uint<64>
  );
  return authorizedAction.eventHash;
}

export circuit revokeIssuerAuthorization(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  authorizationId: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedAuthorizationId = disclose(authorizationId);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const currentRecord = requireIssuerAuthorizationRecord(disclosedAuthorizationId);
  assert(
    currentRecord.status == AuthorizationStatus.active
      || currentRecord.status == AuthorizationStatus.suspended,
    "Issuer authorization must be active or suspended to revoke"
  );
  const actionPayloadHash = disclose(
    updateIssuerAuthorizationPayloadHash(
      disclosedAuthorizationId,
      currentRecord.lifecycleEventHash,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:issuer:revoke"),
    actionPayloadHash
  );

  issuerAuthorizationRecords.insert(
    disclosedAuthorizationId,
    IssuerAuthorizationRecord {
      authorizationId: currentRecord.authorizationId,
      subjectDidCommitment: currentRecord.subjectDidCommitment,
      resourceType: currentRecord.resourceType,
      resourceId: currentRecord.resourceId,
      policyId: currentRecord.policyId,
      trustLevel: currentRecord.trustLevel,
      status: AuthorizationStatus.revoked,
      proposedAtSequence: currentRecord.proposedAtSequence,
      authorizedAtSequence: currentRecord.authorizedAtSequence,
      activeFromSequence: currentRecord.activeFromSequence,
      suspendedAtSequence: currentRecord.suspendedAtSequence,
      revokedAtSequence: authorizedAction.actionSequence,
      archivedAtSequence: currentRecord.archivedAtSequence,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  if (currentRecord.status == AuthorizationStatus.active) {
    activeIssuerAuthorizationCount = disclose(
      (activeIssuerAuthorizationCount - (1 as Uint<64>)) as Uint<64>
    );
  }
  return authorizedAction.eventHash;
}

export circuit archiveIssuerAuthorization(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  authorizationId: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedAuthorizationId = disclose(authorizationId);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const currentRecord = requireIssuerAuthorizationRecord(disclosedAuthorizationId);
  assert(
    currentRecord.status == AuthorizationStatus.active
      || currentRecord.status == AuthorizationStatus.suspended
      || currentRecord.status == AuthorizationStatus.revoked,
    "Issuer authorization must be active, suspended, or revoked to archive"
  );
  const actionPayloadHash = disclose(
    updateIssuerAuthorizationPayloadHash(
      disclosedAuthorizationId,
      currentRecord.lifecycleEventHash,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:issuer:archive"),
    actionPayloadHash
  );

  issuerAuthorizationRecords.insert(
    disclosedAuthorizationId,
    IssuerAuthorizationRecord {
      authorizationId: currentRecord.authorizationId,
      subjectDidCommitment: currentRecord.subjectDidCommitment,
      resourceType: currentRecord.resourceType,
      resourceId: currentRecord.resourceId,
      policyId: currentRecord.policyId,
      trustLevel: currentRecord.trustLevel,
      status: AuthorizationStatus.archived,
      proposedAtSequence: currentRecord.proposedAtSequence,
      authorizedAtSequence: currentRecord.authorizedAtSequence,
      activeFromSequence: currentRecord.activeFromSequence,
      suspendedAtSequence: currentRecord.suspendedAtSequence,
      revokedAtSequence: currentRecord.revokedAtSequence,
      archivedAtSequence: authorizedAction.actionSequence,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  if (currentRecord.status == AuthorizationStatus.active) {
    activeIssuerAuthorizationCount = disclose(
      (activeIssuerAuthorizationCount - (1 as Uint<64>)) as Uint<64>
    );
  }
  return authorizedAction.eventHash;
}

export circuit getIssuerAuthorization(
  authorizationId: Bytes<32>
): IssuerAuthorizationRecord {
  assert(initialized, "Trust registry is not initialized");
  return requireIssuerAuthorizationRecord(disclose(authorizationId));
}

export circuit getCurrentIssuerAuthorization(
  subjectDidCommitment: Bytes<32>,
  resourceType: IssuerResourceType,
  resourceId: Bytes<32>
): IssuerAuthorizationRecord {
  assert(initialized, "Trust registry is not initialized");
  return currentIssuerAuthorizationRecord(
    subjectDidCommitment,
    resourceType,
    resourceId
  );
}

export circuit assertIssuerAuthorized(
  subjectDidCommitment: Bytes<32>,
  resourceType: IssuerResourceType,
  resourceId: Bytes<32>
): [] {
  assert(initialized, "Trust registry is not initialized");
  const currentRecord = currentIssuerAuthorizationRecord(
    subjectDidCommitment,
    resourceType,
    resourceId
  );
  assert(
    currentRecord.status == AuthorizationStatus.active,
    "Issuer authorization is not active"
  );
}
