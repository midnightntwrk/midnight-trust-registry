export pure circuit createEpochCommitmentPayloadHash(
  epochId: Bytes<32>,
  stateRoot: Bytes<32>,
  eventRoot: Bytes<32>,
  policyRoot: Bytes<32>,
  validFromSequence: Uint<64>,
  validUntilSequence: Uint<64>
): Bytes<32> {
  assertEpochCommitmentFields(
    epochId,
    stateRoot,
    eventRoot,
    policyRoot,
    validFromSequence,
    validUntilSequence
  );
  return persistentHash<Vector<6, Bytes<32>>>([
    epochId,
    stateRoot,
    eventRoot,
    policyRoot,
    ((validFromSequence as Field) as Bytes<32>),
    ((validUntilSequence as Field) as Bytes<32>)
  ]);
}

export pure circuit updateIssuerAuthorizationPayloadHash(
  authorizationId: Bytes<32>,
  previousLifecycleEventHash: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  assert(
    authorizationId != pad(32, ""),
    "Issuer authorization id must be set"
  );
  assert(
    previousLifecycleEventHash != pad(32, ""),
    "Issuer authorization lifecycle event hash must be set"
  );
  assert(
    evidenceHash != pad(32, ""),
    "Issuer authorization evidence hash must be set"
  );
  return persistentHash<Vector<3, Bytes<32>>>([
    authorizationId,
    previousLifecycleEventHash,
    evidenceHash
  ]);
}

