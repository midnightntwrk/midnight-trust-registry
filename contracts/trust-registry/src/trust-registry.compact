pragma language_version >= 0.20;

import CompactStandardLibrary;
import "../../../libs/midnight-did/jubjub-schnorr/src/schnorr" prefix Schnorr_;

export enum MaintainerStatus {
  active,
  suspended,
  revoked,
  archived
}

export struct MaintainerRecord {
  keyId: Bytes<32>,
  publicKey: JubjubPoint,
  status: MaintainerStatus,
  joinedAtSequence: Uint<64>,
  lastStatusSequence: Uint<64>,
}

export enum AuthorizationStatus {
  proposed,
  authorized,
  active,
  suspended,
  revoked,
  archived
}

export enum IssuerResourceType {
  credentialFamily,
  schema,
  schemaVersion,
  credentialDefinition,
  statusMethodRequirement
}

export struct IssuerAuthorizationRecord {
  authorizationId: Bytes<32>,
  subjectDidCommitment: Bytes<32>,
  resourceType: IssuerResourceType,
  resourceId: Bytes<32>,
  policyId: Bytes<32>,
  trustLevel: Bytes<32>,
  status: AuthorizationStatus,
  proposedAtSequence: Uint<64>,
  authorizedAtSequence: Uint<64>,
  activeFromSequence: Uint<64>,
  suspendedAtSequence: Uint<64>,
  revokedAtSequence: Uint<64>,
  archivedAtSequence: Uint<64>,
  lastStatusSequence: Uint<64>,
  evidenceHash: Bytes<32>,
  lifecycleEventHash: Bytes<32>,
}

export struct VerifierAuthorizationRecord {
  authorizationId: Bytes<32>,
  subjectDidCommitment: Bytes<32>,
  requestProfileId: Bytes<32>,
  allowedAttributeSetCommitment: Bytes<32>,
  allowedPredicateSetCommitment: Bytes<32>,
  disclosureLevelCommitment: Bytes<32>,
  policyId: Bytes<32>,
  trustLevel: Bytes<32>,
  status: AuthorizationStatus,
  proposedAtSequence: Uint<64>,
  authorizedAtSequence: Uint<64>,
  activeFromSequence: Uint<64>,
  suspendedAtSequence: Uint<64>,
  revokedAtSequence: Uint<64>,
  archivedAtSequence: Uint<64>,
  lastStatusSequence: Uint<64>,
  evidenceHash: Bytes<32>,
  lifecycleEventHash: Bytes<32>,
}

export struct AuditorAuthorizationRecord {
  authorizationId: Bytes<32>,
  subjectDidCommitment: Bytes<32>,
  requestProfileId: Bytes<32>,
  allowedAttributeSetCommitment: Bytes<32>,
  allowedPredicateSetCommitment: Bytes<32>,
  disclosureLevelCommitment: Bytes<32>,
  policyId: Bytes<32>,
  trustLevel: Bytes<32>,
  status: AuthorizationStatus,
  proposedAtSequence: Uint<64>,
  authorizedAtSequence: Uint<64>,
  activeFromSequence: Uint<64>,
  suspendedAtSequence: Uint<64>,
  revokedAtSequence: Uint<64>,
  archivedAtSequence: Uint<64>,
  lastStatusSequence: Uint<64>,
  evidenceHash: Bytes<32>,
  lifecycleEventHash: Bytes<32>,
}

export struct RecognitionRecord {
  recognitionId: Bytes<32>,
  recognizedAuthorityDidCommitment: Bytes<32>,
  recognizedRegistryId: Bytes<32>,
  scopeResourceType: Bytes<32>,
  scopeResourceId: Bytes<32>,
  policyId: Bytes<32>,
  trustLevel: Bytes<32>,
  status: AuthorizationStatus,
  proposedAtSequence: Uint<64>,
  authorizedAtSequence: Uint<64>,
  effectiveFromSequence: Uint<64>,
  suspendedAtSequence: Uint<64>,
  revokedAtSequence: Uint<64>,
  archivedAtSequence: Uint<64>,
  lastStatusSequence: Uint<64>,
  evidenceHash: Bytes<32>,
  lifecycleEventHash: Bytes<32>,
}

export struct EpochCommitmentRecord {
  epochId: Bytes<32>,
  stateRoot: Bytes<32>,
  eventRoot: Bytes<32>,
  policyRoot: Bytes<32>,
  validFromSequence: Uint<64>,
  validUntilSequence: Uint<64>,
  publishedAtSequence: Uint<64>,
  maintainerKeyId: Bytes<32>,
