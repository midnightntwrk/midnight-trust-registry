      recognizedAuthorityDidCommitment:
        currentRecord.recognizedAuthorityDidCommitment,
      recognizedRegistryId: currentRecord.recognizedRegistryId,
      scopeResourceType: currentRecord.scopeResourceType,
      scopeResourceId: currentRecord.scopeResourceId,
      policyId: currentRecord.policyId,
      trustLevel: currentRecord.trustLevel,
      status: AuthorizationStatus.suspended,
      proposedAtSequence: currentRecord.proposedAtSequence,
      authorizedAtSequence: currentRecord.authorizedAtSequence,
      effectiveFromSequence: currentRecord.effectiveFromSequence,
      suspendedAtSequence: authorizedAction.actionSequence,
      revokedAtSequence: currentRecord.revokedAtSequence,
      archivedAtSequence: currentRecord.archivedAtSequence,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  activeRecognitionCount = disclose(
    (activeRecognitionCount - (1 as Uint<64>)) as Uint<64>
  );
  return authorizedAction.eventHash;
}

export circuit revokeRecognition(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  recognitionId: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedRecognitionId = disclose(recognitionId);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const currentRecord = requireRecognitionRecord(disclosedRecognitionId);
  assert(
    currentRecord.status == AuthorizationStatus.authorized
      || currentRecord.status == AuthorizationStatus.active
      || currentRecord.status == AuthorizationStatus.suspended,
    "Recognition must be authorized, active, or suspended to revoke"
  );
  const actionPayloadHash = disclose(
    updateRecognitionPayloadHash(
      disclosedRecognitionId,
      currentRecord.lifecycleEventHash,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:recognition:revoke"),
    actionPayloadHash
  );

  recognitionRecords.insert(
    disclosedRecognitionId,
    RecognitionRecord {
      recognitionId: currentRecord.recognitionId,
      recognizedAuthorityDidCommitment:
        currentRecord.recognizedAuthorityDidCommitment,
      recognizedRegistryId: currentRecord.recognizedRegistryId,
      scopeResourceType: currentRecord.scopeResourceType,
      scopeResourceId: currentRecord.scopeResourceId,
      policyId: currentRecord.policyId,
      trustLevel: currentRecord.trustLevel,
      status: AuthorizationStatus.revoked,
      proposedAtSequence: currentRecord.proposedAtSequence,
      authorizedAtSequence: currentRecord.authorizedAtSequence,
      effectiveFromSequence: currentRecord.effectiveFromSequence,
      suspendedAtSequence: currentRecord.suspendedAtSequence,
      revokedAtSequence: authorizedAction.actionSequence,
      archivedAtSequence: currentRecord.archivedAtSequence,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  if (currentRecord.status == AuthorizationStatus.active) {
    activeRecognitionCount = disclose(
      (activeRecognitionCount - (1 as Uint<64>)) as Uint<64>
    );
  }
  return authorizedAction.eventHash;
}

export circuit archiveRecognition(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  recognitionId: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedRecognitionId = disclose(recognitionId);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const currentRecord = requireRecognitionRecord(disclosedRecognitionId);
  assert(
    currentRecord.status == AuthorizationStatus.proposed
      || currentRecord.status == AuthorizationStatus.authorized
      || currentRecord.status == AuthorizationStatus.active
      || currentRecord.status == AuthorizationStatus.suspended
      || currentRecord.status == AuthorizationStatus.revoked,
    "Recognition must be proposed, authorized, active, suspended, or revoked to archive"
  );
  const actionPayloadHash = disclose(
    updateRecognitionPayloadHash(
      disclosedRecognitionId,
      currentRecord.lifecycleEventHash,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:recognition:archive"),
    actionPayloadHash
  );

  recognitionRecords.insert(
    disclosedRecognitionId,
    RecognitionRecord {
      recognitionId: currentRecord.recognitionId,
      recognizedAuthorityDidCommitment:
        currentRecord.recognizedAuthorityDidCommitment,
      recognizedRegistryId: currentRecord.recognizedRegistryId,
      scopeResourceType: currentRecord.scopeResourceType,
      scopeResourceId: currentRecord.scopeResourceId,
      policyId: currentRecord.policyId,
      trustLevel: currentRecord.trustLevel,
      status: AuthorizationStatus.archived,
      proposedAtSequence: currentRecord.proposedAtSequence,
      authorizedAtSequence: currentRecord.authorizedAtSequence,
      effectiveFromSequence: currentRecord.effectiveFromSequence,
      suspendedAtSequence: currentRecord.suspendedAtSequence,
      revokedAtSequence: currentRecord.revokedAtSequence,
      archivedAtSequence: authorizedAction.actionSequence,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  if (currentRecord.status == AuthorizationStatus.active) {
    activeRecognitionCount = disclose(
      (activeRecognitionCount - (1 as Uint<64>)) as Uint<64>
    );
  }
  return authorizedAction.eventHash;
}

export circuit getRecognition(
  recognitionId: Bytes<32>
): RecognitionRecord {
  assert(initialized, "Trust registry is not initialized");
  return requireRecognitionRecord(disclose(recognitionId));
}

export circuit getCurrentRecognition(
  recognizedAuthorityDidCommitment: Bytes<32>,
  recognizedRegistryId: Bytes<32>,
  scopeResourceType: Bytes<32>,
  scopeResourceId: Bytes<32>
): RecognitionRecord {
  assert(initialized, "Trust registry is not initialized");
  return currentRecognitionRecord(
    recognizedAuthorityDidCommitment,
    recognizedRegistryId,
    scopeResourceType,
    scopeResourceId
  );
}

export circuit assertRecognitionActive(
  recognizedAuthorityDidCommitment: Bytes<32>,
  recognizedRegistryId: Bytes<32>,
  scopeResourceType: Bytes<32>,
  scopeResourceId: Bytes<32>
): [] {
  assert(initialized, "Trust registry is not initialized");
  const currentRecord = currentRecognitionRecord(
    recognizedAuthorityDidCommitment,
    recognizedRegistryId,
    scopeResourceType,
    scopeResourceId
  );
  assert(
    currentRecord.status == AuthorizationStatus.active,
    "Recognition is not active"
  );
}

export circuit publishEpochCommitment(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  epochId: Bytes<32>,
  stateRoot: Bytes<32>,
  eventRoot: Bytes<32>,
  policyRoot: Bytes<32>,
  validFromSequence: Uint<64>,
  validUntilSequence: Uint<64>
): Bytes<32> {
  const disclosedEpochId = disclose(epochId);
  const disclosedStateRoot = disclose(stateRoot);
  const disclosedEventRoot = disclose(eventRoot);
  const disclosedPolicyRoot = disclose(policyRoot);
  const disclosedValidFromSequence = disclose(validFromSequence);
  const disclosedValidUntilSequence = disclose(validUntilSequence);
  const actionPayloadHash = disclose(
    createEpochCommitmentPayloadHash(
      disclosedEpochId,
      disclosedStateRoot,
      disclosedEventRoot,
      disclosedPolicyRoot,
      disclosedValidFromSequence,
      disclosedValidUntilSequence
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:epoch:publish"),
    actionPayloadHash
  );

  assert(
    !epochCommitmentIds.member(disclosedEpochId),
    "Epoch commitment already exists"
  );

  epochCommitmentIds.insert(disclosedEpochId);
  epochCommitmentRecords.insert(
    disclosedEpochId,
    EpochCommitmentRecord {
      epochId: disclosedEpochId,
      stateRoot: disclosedStateRoot,
      eventRoot: disclosedEventRoot,
      policyRoot: disclosedPolicyRoot,
      validFromSequence: disclosedValidFromSequence,
      validUntilSequence: disclosedValidUntilSequence,
      publishedAtSequence: authorizedAction.actionSequence,
      maintainerKeyId: authorizedAction.maintainerKeyId,
      signatureAnnouncement: disclose(signature.announcement),
      signatureResponse: disclose(signature.response),
      publicationEventHash: authorizedAction.eventHash
    }
  );
  epochCommitmentCount.increment(1);
  latestEpochCommitmentId = disclosedEpochId;
  return authorizedAction.eventHash;
}

export circuit getEpochCommitment(
  epochId: Bytes<32>
): EpochCommitmentRecord {
  assert(initialized, "Trust registry is not initialized");
  return requireEpochCommitmentRecord(disclose(epochId));
}

export circuit getCurrentEpochCommitment(): EpochCommitmentRecord {
  assert(initialized, "Trust registry is not initialized");
  assert(
    epochCommitmentCount.read() > 0,
    "No epoch commitment has been published"
  );
  return epochCommitmentRecords.lookup(latestEpochCommitmentId);
}
