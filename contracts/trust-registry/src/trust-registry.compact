  auditorAuthorizationRecords.insert(
    disclosedAuthorizationId,
    AuditorAuthorizationRecord {
      authorizationId: currentRecord.authorizationId,
      subjectDidCommitment: currentRecord.subjectDidCommitment,
      requestProfileId: currentRecord.requestProfileId,
      allowedAttributeSetCommitment: currentRecord.allowedAttributeSetCommitment,
      allowedPredicateSetCommitment:
        currentRecord.allowedPredicateSetCommitment,
      disclosureLevelCommitment: currentRecord.disclosureLevelCommitment,
      policyId: currentRecord.policyId,
      trustLevel: currentRecord.trustLevel,
      status: AuthorizationStatus.active,
      proposedAtSequence: currentRecord.proposedAtSequence,
      authorizedAtSequence: currentRecord.authorizedAtSequence,
      activeFromSequence: authorizedAction.actionSequence,
      suspendedAtSequence: currentRecord.suspendedAtSequence,
      revokedAtSequence: currentRecord.revokedAtSequence,
      archivedAtSequence: currentRecord.archivedAtSequence,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  activeAuditorAuthorizationCount = disclose(
    (activeAuditorAuthorizationCount + (1 as Uint<64>)) as Uint<64>
  );
  return authorizedAction.eventHash;
}

export circuit suspendAuditorAuthorization(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  authorizationId: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedAuthorizationId = disclose(authorizationId);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const currentRecord = requireAuditorAuthorizationRecord(disclosedAuthorizationId);
  assert(
    currentRecord.status == AuthorizationStatus.active,
    "Auditor authorization must be active to suspend"
  );
  const actionPayloadHash = disclose(
    updateAuditorAuthorizationPayloadHash(
      disclosedAuthorizationId,
      currentRecord.lifecycleEventHash,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:auditor:suspend"),
    actionPayloadHash
  );

  auditorAuthorizationRecords.insert(
    disclosedAuthorizationId,
    AuditorAuthorizationRecord {
      authorizationId: currentRecord.authorizationId,
      subjectDidCommitment: currentRecord.subjectDidCommitment,
      requestProfileId: currentRecord.requestProfileId,
      allowedAttributeSetCommitment: currentRecord.allowedAttributeSetCommitment,
      allowedPredicateSetCommitment:
        currentRecord.allowedPredicateSetCommitment,
      disclosureLevelCommitment: currentRecord.disclosureLevelCommitment,
      policyId: currentRecord.policyId,
      trustLevel: currentRecord.trustLevel,
      status: AuthorizationStatus.suspended,
      proposedAtSequence: currentRecord.proposedAtSequence,
      authorizedAtSequence: currentRecord.authorizedAtSequence,
      activeFromSequence: currentRecord.activeFromSequence,
      suspendedAtSequence: authorizedAction.actionSequence,
      revokedAtSequence: currentRecord.revokedAtSequence,
      archivedAtSequence: currentRecord.archivedAtSequence,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  activeAuditorAuthorizationCount = disclose(
    (activeAuditorAuthorizationCount - (1 as Uint<64>)) as Uint<64>
  );
  return authorizedAction.eventHash;
}

export circuit revokeAuditorAuthorization(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  authorizationId: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedAuthorizationId = disclose(authorizationId);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const currentRecord = requireAuditorAuthorizationRecord(disclosedAuthorizationId);
  assert(
    currentRecord.status == AuthorizationStatus.authorized
      || currentRecord.status == AuthorizationStatus.active
      || currentRecord.status == AuthorizationStatus.suspended,
    "Auditor authorization must be authorized, active, or suspended to revoke"
  );
  const actionPayloadHash = disclose(
    updateAuditorAuthorizationPayloadHash(
      disclosedAuthorizationId,
      currentRecord.lifecycleEventHash,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:auditor:revoke"),
    actionPayloadHash
  );

  auditorAuthorizationRecords.insert(
    disclosedAuthorizationId,
    AuditorAuthorizationRecord {
      authorizationId: currentRecord.authorizationId,
      subjectDidCommitment: currentRecord.subjectDidCommitment,
      requestProfileId: currentRecord.requestProfileId,
      allowedAttributeSetCommitment: currentRecord.allowedAttributeSetCommitment,
      allowedPredicateSetCommitment:
        currentRecord.allowedPredicateSetCommitment,
      disclosureLevelCommitment: currentRecord.disclosureLevelCommitment,
      policyId: currentRecord.policyId,
      trustLevel: currentRecord.trustLevel,
      status: AuthorizationStatus.revoked,
      proposedAtSequence: currentRecord.proposedAtSequence,
      authorizedAtSequence: currentRecord.authorizedAtSequence,
      activeFromSequence: currentRecord.activeFromSequence,
      suspendedAtSequence: currentRecord.suspendedAtSequence,
      revokedAtSequence: authorizedAction.actionSequence,
      archivedAtSequence: currentRecord.archivedAtSequence,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  if (currentRecord.status == AuthorizationStatus.active) {
    activeAuditorAuthorizationCount = disclose(
      (activeAuditorAuthorizationCount - (1 as Uint<64>)) as Uint<64>
    );
  }
  return authorizedAction.eventHash;
}

export circuit archiveAuditorAuthorization(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  authorizationId: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedAuthorizationId = disclose(authorizationId);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const currentRecord = requireAuditorAuthorizationRecord(disclosedAuthorizationId);
  assert(
    currentRecord.status == AuthorizationStatus.proposed
      || currentRecord.status == AuthorizationStatus.authorized
      || currentRecord.status == AuthorizationStatus.active
      || currentRecord.status == AuthorizationStatus.suspended
      || currentRecord.status == AuthorizationStatus.revoked,
    "Auditor authorization must be proposed, authorized, active, suspended, or revoked to archive"
  );
  const actionPayloadHash = disclose(
    updateAuditorAuthorizationPayloadHash(
      disclosedAuthorizationId,
      currentRecord.lifecycleEventHash,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:auditor:archive"),
    actionPayloadHash
  );

  auditorAuthorizationRecords.insert(
    disclosedAuthorizationId,
    AuditorAuthorizationRecord {
      authorizationId: currentRecord.authorizationId,
      subjectDidCommitment: currentRecord.subjectDidCommitment,
      requestProfileId: currentRecord.requestProfileId,
      allowedAttributeSetCommitment: currentRecord.allowedAttributeSetCommitment,
      allowedPredicateSetCommitment:
        currentRecord.allowedPredicateSetCommitment,
      disclosureLevelCommitment: currentRecord.disclosureLevelCommitment,
      policyId: currentRecord.policyId,
      trustLevel: currentRecord.trustLevel,
      status: AuthorizationStatus.archived,
      proposedAtSequence: currentRecord.proposedAtSequence,
      authorizedAtSequence: currentRecord.authorizedAtSequence,
      activeFromSequence: currentRecord.activeFromSequence,
      suspendedAtSequence: currentRecord.suspendedAtSequence,
      revokedAtSequence: currentRecord.revokedAtSequence,
      archivedAtSequence: authorizedAction.actionSequence,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  if (currentRecord.status == AuthorizationStatus.active) {
    activeAuditorAuthorizationCount = disclose(
      (activeAuditorAuthorizationCount - (1 as Uint<64>)) as Uint<64>
    );
  }
  return authorizedAction.eventHash;
}

export circuit getAuditorAuthorization(
  authorizationId: Bytes<32>
): AuditorAuthorizationRecord {
  assert(initialized, "Trust registry is not initialized");
  return requireAuditorAuthorizationRecord(disclose(authorizationId));
}

export circuit getCurrentAuditorAuthorization(
  subjectDidCommitment: Bytes<32>,
  requestProfileId: Bytes<32>,
  allowedAttributeSetCommitment: Bytes<32>,
  allowedPredicateSetCommitment: Bytes<32>,
  disclosureLevelCommitment: Bytes<32>
): AuditorAuthorizationRecord {
  assert(initialized, "Trust registry is not initialized");
  return currentAuditorAuthorizationRecord(
    subjectDidCommitment,
    requestProfileId,
    allowedAttributeSetCommitment,
    allowedPredicateSetCommitment,
    disclosureLevelCommitment
  );
}

export circuit assertAuditorAuthorized(
  subjectDidCommitment: Bytes<32>,
  requestProfileId: Bytes<32>,
  allowedAttributeSetCommitment: Bytes<32>,
  allowedPredicateSetCommitment: Bytes<32>,
  disclosureLevelCommitment: Bytes<32>
): [] {
  assert(initialized, "Trust registry is not initialized");
  const currentRecord = currentAuditorAuthorizationRecord(
    subjectDidCommitment,
    requestProfileId,
    allowedAttributeSetCommitment,
    allowedPredicateSetCommitment,
    disclosureLevelCommitment
  );
  assert(
    currentRecord.status == AuthorizationStatus.active,
    "Auditor authorization is not active"
  );
}

export circuit proposeRecognition(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  recognitionId: Bytes<32>,
  recognizedAuthorityDidCommitment: Bytes<32>,
  recognizedRegistryId: Bytes<32>,
  scopeResourceType: Bytes<32>,
  scopeResourceId: Bytes<32>,
  policyId: Bytes<32>,
  trustLevel: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedRecognitionId = disclose(recognitionId);
  const disclosedRecognizedAuthorityDidCommitment = disclose(
    recognizedAuthorityDidCommitment
  );
  const disclosedRecognizedRegistryId = disclose(recognizedRegistryId);
  const disclosedScopeResourceType = disclose(scopeResourceType);
  const disclosedScopeResourceId = disclose(scopeResourceId);
  const disclosedPolicyId = disclose(policyId);
  const disclosedTrustLevel = disclose(trustLevel);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const scopeKey = disclose(
    recognitionScopeKey(
      disclosedRecognizedAuthorityDidCommitment,
      disclosedRecognizedRegistryId,
      disclosedScopeResourceType,
      disclosedScopeResourceId
    )
  );
  const actionPayloadHash = disclose(
    createRecognitionPayloadHash(
      disclosedRecognitionId,
      disclosedRecognizedAuthorityDidCommitment,
      disclosedRecognizedRegistryId,
      disclosedScopeResourceType,
      disclosedScopeResourceId,
      disclosedPolicyId,
      disclosedTrustLevel,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:recognition:propose"),
    actionPayloadHash
  );

  assert(
    !recognitionIds.member(disclosedRecognitionId),
    "Recognition already exists"
  );
  if (currentRecognitionIdsByScopeKey.member(scopeKey)) {
    const currentRecord = recognitionRecords.lookup(
      currentRecognitionIdsByScopeKey.lookup(scopeKey)
    );
    assert(
      currentRecord.status == AuthorizationStatus.revoked
        || currentRecord.status == AuthorizationStatus.archived,
      "Recognition scope already has a live recognition"
    );
  }

  recognitionIds.insert(disclosedRecognitionId);
  recognitionRecords.insert(
    disclosedRecognitionId,
    RecognitionRecord {
      recognitionId: disclosedRecognitionId,
      recognizedAuthorityDidCommitment:
        disclosedRecognizedAuthorityDidCommitment,
      recognizedRegistryId: disclosedRecognizedRegistryId,
      scopeResourceType: disclosedScopeResourceType,
      scopeResourceId: disclosedScopeResourceId,
      policyId: disclosedPolicyId,
      trustLevel: disclosedTrustLevel,
      status: AuthorizationStatus.proposed,
      proposedAtSequence: authorizedAction.actionSequence,
      authorizedAtSequence: 0,
      effectiveFromSequence: 0,
      suspendedAtSequence: 0,
      revokedAtSequence: 0,
      archivedAtSequence: 0,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  currentRecognitionIdsByScopeKey.insert(scopeKey, disclosedRecognitionId);
  recognitionCount.increment(1);
  return authorizedAction.eventHash;
}

