export pure circuit createIssuerAuthorizationPayloadHash(
  authorizationId: Bytes<32>,
  subjectDidCommitment: Bytes<32>,
  resourceType: IssuerResourceType,
  resourceId: Bytes<32>,
  policyId: Bytes<32>,
  trustLevel: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  assertIssuerAuthorizationFields(
    authorizationId,
    subjectDidCommitment,
    resourceId,
    policyId,
    trustLevel,
    evidenceHash
  );
  return persistentHash<Vector<7, Bytes<32>>>([
    authorizationId,
    subjectDidCommitment,
    issuerResourceTypeLabel(resourceType),
    resourceId,
    policyId,
    trustLevel,
    evidenceHash
  ]);
}

