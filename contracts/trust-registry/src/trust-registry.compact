export circuit suspendRecognition(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  recognitionId: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedRecognitionId = disclose(recognitionId);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const currentRecord = requireRecognitionRecord(disclosedRecognitionId);
  assert(
    currentRecord.status == AuthorizationStatus.active,
    "Recognition must be active to suspend"
