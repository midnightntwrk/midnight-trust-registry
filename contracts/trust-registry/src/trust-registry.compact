export circuit proposeVerifierAuthorization(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  authorizationId: Bytes<32>,
  subjectDidCommitment: Bytes<32>,
  requestProfileId: Bytes<32>,
  allowedAttributeSetCommitment: Bytes<32>,
  allowedPredicateSetCommitment: Bytes<32>,
  disclosureLevelCommitment: Bytes<32>,
  policyId: Bytes<32>,
  trustLevel: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedAuthorizationId = disclose(authorizationId);
  const disclosedSubjectDidCommitment = disclose(subjectDidCommitment);
  const disclosedRequestProfileId = disclose(requestProfileId);
  const disclosedAllowedAttributeSetCommitment = disclose(
    allowedAttributeSetCommitment
  );
  const disclosedAllowedPredicateSetCommitment = disclose(
    allowedPredicateSetCommitment
  );
  const disclosedDisclosureLevelCommitment = disclose(
    disclosureLevelCommitment
  );
  const disclosedPolicyId = disclose(policyId);
  const disclosedTrustLevel = disclose(trustLevel);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const scopeKey = disclose(
    verifierAuthorizationScopeKey(
      disclosedSubjectDidCommitment,
      disclosedRequestProfileId,
      disclosedAllowedAttributeSetCommitment,
      disclosedAllowedPredicateSetCommitment,
      disclosedDisclosureLevelCommitment
    )
  );
  const actionPayloadHash = disclose(
    createVerifierAuthorizationPayloadHash(
      disclosedAuthorizationId,
      disclosedSubjectDidCommitment,
      disclosedRequestProfileId,
      disclosedAllowedAttributeSetCommitment,
      disclosedAllowedPredicateSetCommitment,
      disclosedDisclosureLevelCommitment,
      disclosedPolicyId,
      disclosedTrustLevel,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:verifier:propose"),
    actionPayloadHash
  );

  assert(
    !verifierAuthorizationIds.member(disclosedAuthorizationId),
    "Verifier authorization already exists"
  );
  if (currentVerifierAuthorizationIdsByScopeKey.member(scopeKey)) {
    const currentRecord = verifierAuthorizationRecords.lookup(
      currentVerifierAuthorizationIdsByScopeKey.lookup(scopeKey)
    );
    assert(
      currentRecord.status == AuthorizationStatus.revoked
        || currentRecord.status == AuthorizationStatus.archived,
      "Verifier authorization scope already has a live authorization"
    );
  }

  verifierAuthorizationIds.insert(disclosedAuthorizationId);
  verifierAuthorizationRecords.insert(
    disclosedAuthorizationId,
    VerifierAuthorizationRecord {
      authorizationId: disclosedAuthorizationId,
      subjectDidCommitment: disclosedSubjectDidCommitment,
      requestProfileId: disclosedRequestProfileId,
      allowedAttributeSetCommitment: disclosedAllowedAttributeSetCommitment,
      allowedPredicateSetCommitment: disclosedAllowedPredicateSetCommitment,
      disclosureLevelCommitment: disclosedDisclosureLevelCommitment,
      policyId: disclosedPolicyId,
      trustLevel: disclosedTrustLevel,
      status: AuthorizationStatus.proposed,
      proposedAtSequence: authorizedAction.actionSequence,
      authorizedAtSequence: 0,
      activeFromSequence: 0,
      suspendedAtSequence: 0,
      revokedAtSequence: 0,
      archivedAtSequence: 0,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  currentVerifierAuthorizationIdsByScopeKey.insert(
    scopeKey,
    disclosedAuthorizationId
  );
  verifierAuthorizationCount.increment(1);
  return authorizedAction.eventHash;
}

export circuit authorizeVerifierAuthorization(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  authorizationId: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedAuthorizationId = disclose(authorizationId);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const currentRecord = requireVerifierAuthorizationRecord(disclosedAuthorizationId);
  assert(
    currentRecord.status == AuthorizationStatus.proposed,
    "Verifier authorization must be proposed to authorize"
  );
  const actionPayloadHash = disclose(
    updateVerifierAuthorizationPayloadHash(
      disclosedAuthorizationId,
      currentRecord.lifecycleEventHash,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:verifier:authorize"),
    actionPayloadHash
  );

  verifierAuthorizationRecords.insert(
    disclosedAuthorizationId,
    VerifierAuthorizationRecord {
      authorizationId: currentRecord.authorizationId,
      subjectDidCommitment: currentRecord.subjectDidCommitment,
      requestProfileId: currentRecord.requestProfileId,
      allowedAttributeSetCommitment: currentRecord.allowedAttributeSetCommitment,
      allowedPredicateSetCommitment:
        currentRecord.allowedPredicateSetCommitment,
      disclosureLevelCommitment: currentRecord.disclosureLevelCommitment,
      policyId: currentRecord.policyId,
      trustLevel: currentRecord.trustLevel,
      status: AuthorizationStatus.authorized,
      proposedAtSequence: currentRecord.proposedAtSequence,
      authorizedAtSequence: authorizedAction.actionSequence,
      activeFromSequence: 0,
      suspendedAtSequence: currentRecord.suspendedAtSequence,
      revokedAtSequence: currentRecord.revokedAtSequence,
      archivedAtSequence: currentRecord.archivedAtSequence,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  return authorizedAction.eventHash;
}

export circuit createVerifierAuthorization(
  maintainerKeyId: Bytes<32>,
  maintainerPublicKey: JubjubPoint,
  signature: JubjubSignature,
  authorizationId: Bytes<32>,
  subjectDidCommitment: Bytes<32>,
  requestProfileId: Bytes<32>,
  allowedAttributeSetCommitment: Bytes<32>,
  allowedPredicateSetCommitment: Bytes<32>,
  disclosureLevelCommitment: Bytes<32>,
  policyId: Bytes<32>,
  trustLevel: Bytes<32>,
  evidenceHash: Bytes<32>
): Bytes<32> {
  const disclosedAuthorizationId = disclose(authorizationId);
  const disclosedSubjectDidCommitment = disclose(subjectDidCommitment);
  const disclosedRequestProfileId = disclose(requestProfileId);
  const disclosedAllowedAttributeSetCommitment = disclose(
    allowedAttributeSetCommitment
  );
  const disclosedAllowedPredicateSetCommitment = disclose(
    allowedPredicateSetCommitment
  );
  const disclosedDisclosureLevelCommitment = disclose(
    disclosureLevelCommitment
  );
  const disclosedPolicyId = disclose(policyId);
  const disclosedTrustLevel = disclose(trustLevel);
  const disclosedEvidenceHash = disclose(evidenceHash);
  const scopeKey = disclose(
    verifierAuthorizationScopeKey(
      disclosedSubjectDidCommitment,
      disclosedRequestProfileId,
      disclosedAllowedAttributeSetCommitment,
      disclosedAllowedPredicateSetCommitment,
      disclosedDisclosureLevelCommitment
    )
  );
  const actionPayloadHash = disclose(
    createVerifierAuthorizationPayloadHash(
      disclosedAuthorizationId,
      disclosedSubjectDidCommitment,
      disclosedRequestProfileId,
      disclosedAllowedAttributeSetCommitment,
      disclosedAllowedPredicateSetCommitment,
      disclosedDisclosureLevelCommitment,
      disclosedPolicyId,
      disclosedTrustLevel,
      disclosedEvidenceHash
    )
  );
  const authorizedAction = performAuthorizedMaintainerAction(
    maintainerKeyId,
    maintainerPublicKey,
    signature,
    pad(32, "tr:verifier:create"),
    actionPayloadHash
  );

  assert(
    !verifierAuthorizationIds.member(disclosedAuthorizationId),
    "Verifier authorization already exists"
  );
  if (currentVerifierAuthorizationIdsByScopeKey.member(scopeKey)) {
    const currentRecord = verifierAuthorizationRecords.lookup(
      currentVerifierAuthorizationIdsByScopeKey.lookup(scopeKey)
    );
    assert(
      currentRecord.status == AuthorizationStatus.revoked
        || currentRecord.status == AuthorizationStatus.archived,
      "Verifier authorization scope already has a live authorization"
    );
  }

  verifierAuthorizationIds.insert(disclosedAuthorizationId);
  verifierAuthorizationRecords.insert(
    disclosedAuthorizationId,
    VerifierAuthorizationRecord {
      authorizationId: disclosedAuthorizationId,
      subjectDidCommitment: disclosedSubjectDidCommitment,
      requestProfileId: disclosedRequestProfileId,
      allowedAttributeSetCommitment: disclosedAllowedAttributeSetCommitment,
      allowedPredicateSetCommitment: disclosedAllowedPredicateSetCommitment,
      disclosureLevelCommitment: disclosedDisclosureLevelCommitment,
      policyId: disclosedPolicyId,
      trustLevel: disclosedTrustLevel,
      status: AuthorizationStatus.active,
      proposedAtSequence: authorizedAction.actionSequence,
      authorizedAtSequence: authorizedAction.actionSequence,
      activeFromSequence: authorizedAction.actionSequence,
      suspendedAtSequence: 0,
      revokedAtSequence: 0,
      archivedAtSequence: 0,
      lastStatusSequence: authorizedAction.actionSequence,
      evidenceHash: disclosedEvidenceHash,
      lifecycleEventHash: authorizedAction.eventHash
    }
  );
  currentVerifierAuthorizationIdsByScopeKey.insert(
    scopeKey,
    disclosedAuthorizationId
  );
  verifierAuthorizationCount.increment(1);
  activeVerifierAuthorizationCount = disclose(
    (activeVerifierAuthorizationCount + (1 as Uint<64>)) as Uint<64>
  );
  return authorizedAction.eventHash;
}

