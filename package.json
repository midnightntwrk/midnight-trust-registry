{
  "name": "midnight-trust-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.34.1"
  },
  "workspaces": [
    "contracts/*",
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "clean": "turbo run clean --continue",
    "clean:artifacts": "pnpm run clean",
    "docs-check": "./scripts/check-docs.sh",
    "audit": "pnpm audit --audit-level low",
    "check:workspace-manifests": "node scripts/check-workspace-manifests.mjs",
    "check:compact-version": "node --test scripts/check-compact-version.test.mjs && node scripts/check-compact-version.mjs",
    "check:compact-installed": "node scripts/check-compact-version.mjs --check-installed",
    "packages:check-contents": "node scripts/check-package-contents.mjs",
    "artifacts:pack": "node scripts/pack-artifacts.mjs",
    "packed-artifacts:smoke": "node scripts/smoke-packed-artifacts.mjs",
    "published-artifacts:smoke": "node scripts/smoke-published-artifacts.mjs",
    "test:artifact-workspaces": "node scripts/artifact-workspaces.test.mjs",
    "integration": "turbo run integration --continue",
    "lint": "turbo run lint --continue",
    "typecheck": "turbo run typecheck --continue",
    "typecheck:light": "turbo run typecheck --continue --only",
    "build": "turbo run build --continue",
    "build:light": "turbo run build:light --continue",
    "test": "turbo run test --continue",
    "test:light": "turbo run test:light --continue",
    "quality": "pnpm run build && pnpm run typecheck && pnpm run audit",
    "ci:integration": "pnpm run integration",
    "ci:lint": "pnpm run docs-check && pnpm run check:workspace-manifests && pnpm run check:compact-version && pnpm run check:compact-installed && pnpm run test:artifact-workspaces && pnpm run lint",
    "ci:build:light": "pnpm run ci:lint && pnpm run build:light && pnpm run packages:check-contents && pnpm run artifacts:pack && pnpm run packed-artifacts:smoke && pnpm run typecheck:light && pnpm run test:light",
    "ci:build": "pnpm run ci:build:light",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "demo:prepare": "mkdir -p ./artifacts/trust-registry && pnpm --filter @midnight-ntwrk/trust-registry-cli run build && node packages/trust-registry-cli/bin/trust-registry.mjs init-workspace --workspace ./artifacts/trust-registry/workspace.json",
    "demo:prepare:snapshot": "mkdir -p ./artifacts/trust-registry && pnpm --filter @midnight-ntwrk/trust-registry-cli run build && node packages/trust-registry-cli/bin/trust-registry.mjs init-demo --output ./artifacts/trust-registry/demo-snapshot.json",
    "demo:serve:api": "pnpm --filter @midnight-ntwrk/trust-registry-api run build && node packages/trust-registry-api/bin/trust-registry-api.mjs serve --workspace ./artifacts/trust-registry/workspace.json --port 4400",
    "demo:serve:admin-console": "pnpm --filter @midnight-ntwrk/trust-registry-admin-console run serve -- --port 4173",
    "demo:serve:applicant-portal": "pnpm --filter @midnight-ntwrk/trust-registry-applicant-portal run serve -- --port 4175",
    "refresh:identity-dependencies": "node scripts/refresh-identity-dependencies.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/credential-compact": "0.2.0",
    "@midnight-ntwrk/credential-did-midnight": "0.2.0",
    "@midnight-ntwrk/midnight-did": "0.7.0",
    "@midnight-ntwrk/midnight-did-contract": "0.7.0",
    "@midnight-ntwrk/midnight-did-domain": "0.7.0",
    "@midnight-ntwrk/midnight-did-jubjub-schnorr": "0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "turbo": "^2.10.13",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
